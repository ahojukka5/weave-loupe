{
  "format": "weave-loupe-runtime-cases-v1",
  "timeout_seconds": 5,
  "inherit_environment": false,
  "optimized_llvm_budget": {
    "format": "weave-loupe-optimized-llvm-budget-v1",
    "min_functions": 1,
    "max_functions": 1,
    "min_basic_blocks": 4,
    "max_basic_blocks": 6,
    "min_instructions": 12,
    "max_instructions": 20,
    "max_alloca": 0,
    "max_load": 0,
    "max_store": 0,
    "min_call": 2,
    "max_call": 2,
    "max_invoke": 0,
    "min_phi": 2,
    "max_phi": 5,
    "min_br": 3,
    "max_br": 5,
    "max_switch": 0,
    "min_ret": 1,
    "max_ret": 1,
    "min_add": 1,
    "max_add": 2,
    "min_icmp": 2,
    "max_icmp": 4,
    "max_identity_adds": 0,
    "max_undef_uses": 0,
    "max_poison_uses": 0,
    "required_defined_functions": [
      "main"
    ],
    "required_call_targets": [
      "atoi",
      "getenv"
    ]
  },
  "native_budget": {
    "format": "weave-loupe-native-budget-v1",
    "max_program_owned_functions": 1,
    "max_reachable_program_functions": 1,
    "max_unreachable_program_functions": 0,
    "max_unreachable_program_instructions": 0,
    "functions": {
      "main": {
        "max_instructions": 32,
        "max_padding_instructions": 1,
        "max_direct_calls": 2,
        "max_indirect_calls": 0,
        "min_backward_conditional_branches": 1,
        "max_backward_conditional_branches": 1,
        "required_direct_calls": [
          "atoi@plt",
          "getenv@plt"
        ]
      }
    }
  },
  "cases": [
    {
      "name": "missing-input-defaults-to-ten",
      "expect": {
        "exit_code": 55,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "zero",
      "env": {
        "WEAVE_AUDIT_N": "0"
      },
      "expect": {
        "exit_code": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "one",
      "env": {
        "WEAVE_AUDIT_N": "1"
      },
      "expect": {
        "exit_code": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "two",
      "env": {
        "WEAVE_AUDIT_N": "2"
      },
      "expect": {
        "exit_code": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "ten",
      "env": {
        "WEAVE_AUDIT_N": "10"
      },
      "expect": {
        "exit_code": 55,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "twelve",
      "env": {
        "WEAVE_AUDIT_N": "12"
      },
      "expect": {
        "exit_code": 144,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "negative-falls-back",
      "env": {
        "WEAVE_AUDIT_N": "-1"
      },
      "expect": {
        "exit_code": 55,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "too-large-falls-back",
      "env": {
        "WEAVE_AUDIT_N": "47"
      },
      "expect": {
        "exit_code": 55,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "non-numeric-atoi-zero",
      "env": {
        "WEAVE_AUDIT_N": "abc"
      },
      "expect": {
        "exit_code": 0,
        "stdout": "",
        "stderr": ""
      }
    }
  ]
}
